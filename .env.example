# ==============================================================================
# SoWeBuild Studio - Environment Variables Template
# ==============================================================================
# IMPORTANT:
# - Copy this file to .env.local for local development: cp .env.example .env.local
# - NEVER commit .env or .env.local to Git! (.env* is in .gitignore)
# - Discord automatically invalidates any webhook URL pushed to GitHub.
# - In production (Vercel/Cloudflare/hosting), add DISCORD_WEBHOOK_URL in project settings.
# ==============================================================================

# Discord Webhook URL for client inquiry lead notifications
# To generate a webhook:
# 1. In your Discord server, open the target channel settings.
# 2. Go to Integrations -> Webhooks -> "New Webhook".
# 3. Copy Webhook URL and paste below.
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

